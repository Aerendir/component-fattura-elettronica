includes:
    - .baseline-phpstan.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    reportUnmatchedIgnoredErrors: false
    level: max
    bootstrapFiles:
        - vendor-bin/phpunit/vendor/autoload.php
    paths:
        - src
        - tests
    # These models are still stubs: their methods declare return types they do not return yet.
    excludePaths:
        - src/Model/Header.php
        - src/Model/FatturaElettronica.php
        - src/Model/Body.php
